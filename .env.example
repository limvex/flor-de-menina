# Database
DATABASE_URL="postgresql://flor:flor@localhost:5434/flor_de_menina"

# JWT (>= 32 caracteres — exigido pela validação de env da API em todos os ambientes)
JWT_SECRET="dev-jwt-secret-change-me-32-characters-minimum"
JWT_EXPIRES_IN="7d"

# API
API_PORT=3333
NEXT_PUBLIC_API_URL="http://localhost:3333"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
WEB_URL="http://localhost:3000"

# Mercado Pago: credenciais na seção "Pagamentos" / checkout abaixo (MP_ACCESS_TOKEN, NEXT_PUBLIC_MP_PUBLIC_KEY).

# Melhor Envio
# Redirect deve ser a URL da API Nest (admin/shipping), registrada no app do Melhor Envio.
SHIPPING_PROVIDER="mock"
MELHOR_ENVIO_CLIENT_ID=""
MELHOR_ENVIO_CLIENT_SECRET=""
MELHOR_ENVIO_REDIRECT_URI="http://localhost:3333/admin/shipping/me/callback"
MELHOR_ENVIO_BASE_URL="https://sandbox.melhorenvio.com.br"

# Criptografia de tokens OAuth (64 hex — obrigatório em produção ou com SHIPPING_PROVIDER=melhor_envio)
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"

# Cloudflare R2 (R2Service exige R2_ENDPOINT no boot — mesmo .env da raiz)
R2_ACCOUNT_ID=""
R2_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="flor-de-menina"
R2_PUBLIC_URL=""

# Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Flor de Menina <contato@flordemenina.store>"
RESEND_REPLY_TO="contato@flordemenina.store"

# Redis (BullMQ — fila de e-mails). Alternativa: REDIS_URL=redis://localhost:6379
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL=""

# Logs (API — nestjs-pino)
LOG_LEVEL="info"

# URL da loja para links nos emails
APP_URL="http://localhost:3000"

# Email scheduler
REVIEW_INVITATION_DELAY_DAYS=7

# OpenRouter (IA descrição)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-haiku-4.5"
# true = força modo mock de descrição mesmo com chave (opcional)
MOCK_AI_DESCRIPTION=""

# Testes E2E (apps/api — categories.e2e-spec)
ADMIN_TEST_EMAIL=""
ADMIN_TEST_PASSWORD=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# JWT cliente (separado do admin; >= 32 caracteres cada)
JWT_CUSTOMER_SECRET="dev-customer-secret-change-me-32-characters-min"
JWT_CUSTOMER_EXPIRES_IN="15m"
JWT_CUSTOMER_REFRESH_SECRET="dev-customer-refresh-secret-32-chars-min"
JWT_CUSTOMER_REFRESH_EXPIRES_IN="30d"

# E-mail (dev usa Maildev local; prod usa Resend)
MAIL_PROVIDER="maildev"
MAIL_FROM_EMAIL="contato@flordemenina.store"
MAIL_FROM_NAME="Flor de Menina"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""

# WhatsApp / Instagram (opcional — rodapé dos e-mails operacionais, Task #69)
WHATSAPP_SUPPORT_URL=
INSTAGRAM_URL=

# Analytics / remarketing (opcional — vazio desabilita)
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
MOCK_PAYMENT=true
MOCK_SHIPPING=true
MOCK_GOOGLE_OAUTH=true
NEXT_PUBLIC_MOCK_GOOGLE_OAUTH=true

# --- Pagamentos em dev local (PIX + cartão sem chamar MP na API) ---
# API: PAYMENT_PROVIDER=mock — createOrder/processPayment usam adapter mock (webhook simulado opcional).
# Web: NEXT_PUBLIC_MOCK_PAYMENT=true — Brick de cartão em modo simulado; PIX segue fluxo normal contra a API.
# Para testar Mercado Pago de ponta a ponta: PAYMENT_PROVIDER=mercado_pago, NEXT_PUBLIC_MOCK_PAYMENT=false,
# MP_ACCESS_TOKEN + NEXT_PUBLIC_MP_PUBLIC_KEY da MESMA app em https://www.mercadopago.com.br/developers/panel/app
NEXT_PUBLIC_MOCK_PAYMENT="true"
NEXT_PUBLIC_MP_PUBLIC_KEY=""
MP_PUBLIC_KEY=""

PAYMENT_PROVIDER="mock"
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""
# Somente desenvolvimento: permite webhook sem segredo/HMAC completo. Nunca use em produção.
ALLOW_WEBHOOK_WITHOUT_SECRET="true"
MP_NOTIFICATION_URL=""

# Mock webhook simulation (Task #19 — Webhook MP + finalização)
# Tempo em ms entre processar pagamento e disparar webhook simulado
MOCK_WEBHOOK_PIX_DELAY_MS="8000"
MOCK_WEBHOOK_CARD_DELAY_MS="2000"

# Taxa de aprovação em modo mock
MOCK_PIX_APPROVAL_RATE="0.9"
MOCK_CARD_APPROVAL_RATE="0.8"

# Seed mínimo de produção (`pnpm db:seed:prod`) — não usar no .env local comum
ADMIN_SEED_EMAIL=""
ADMIN_SEED_PASSWORD=""

# Next.js server-only (Docker / Coolify): URL interna da API para fetch server-side (ex.: http://api:3333)
INTERNAL_API_URL=""
COOKIE_DOMAIN=""
