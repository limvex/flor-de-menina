# Database
DATABASE_URL="postgresql://flor:flor@localhost:5434/flor_de_menina"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# API
API_PORT=3333
NEXT_PUBLIC_API_URL="http://localhost:3333"
FRONTEND_URL="http://localhost:3000"
WEB_URL="http://localhost:3000"

# Mercado Pago (preencher quando cliente fornecer)
MP_ACCESS_TOKEN=""
MP_PUBLIC_KEY=""
MP_WEBHOOK_SECRET=""

# Melhor Envio (preencher após OAuth)
ME_CLIENT_ID=""
ME_CLIENT_SECRET=""
ME_REDIRECT_URI=""

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="flor-de-menina"
R2_PUBLIC_URL=""

# Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="contato@flordemenina.site"

# OpenRouter (IA descrição)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="anthropic/claude-haiku-4.5"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Mock mode (true enquanto credenciais reais não chegam)
MOCK_PAYMENT=true
MOCK_SHIPPING=true
