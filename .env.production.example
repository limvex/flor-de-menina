# Copie para `.env.production` na raiz e preencha com segredos reais.
# `docker compose -f docker-compose.production.yml --env-file .env.production ...`
# CI copia este arquivo para validar o compose (`cp .env.production.example .env.production`).

POSTGRES_USER=flor
POSTGRES_PASSWORD=flor
POSTGRES_DB=flor_de_menina

# URL interna do Postgres no stack Compose (serviço `postgres`)
DATABASE_URL=postgresql://flor:flor@postgres:5432/flor_de_menina

REDIS_URL=redis://redis:6379

NODE_ENV=production
PORT=3333
API_PORT=3333

# JWT (>= 32 caracteres cada)
JWT_SECRET=substitua-por-segredo-admin-32-chars-minimo
JWT_CUSTOMER_SECRET=substitua-por-segredo-cliente-32-chars-min
JWT_CUSTOMER_REFRESH_SECRET=substitua-por-refresh-cliente-32-chars

# Hex 64 (obrigatório em produção)
ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

PAYMENT_PROVIDER=mock
SHIPPING_PROVIDER=mock
MAIL_PROVIDER=resend

GOOGLE_CLIENT_ID=substitua
GOOGLE_CLIENT_SECRET=substitua

R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=substitua
R2_SECRET_ACCESS_KEY=substitua
R2_BUCKET_NAME=flor-de-menina
R2_PUBLIC_URL=https://pub-xxx.r2.dev

RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="Flor de Menina <contato@flordemenina.store>"
RESEND_REPLY_TO=contato@flordemenina.store

NEXT_PUBLIC_API_URL=https://flordemenina.store
NEXT_PUBLIC_SITE_URL=https://flordemenina.store

WEB_URL=https://flordemenina.store
FRONTEND_URL=https://flordemenina.store
APP_URL=https://flordemenina.store

# Seed mínimo (uma vez após migrate)
ADMIN_SEED_EMAIL=admin@flordemenina.store
ADMIN_SEED_PASSWORD=TroqueEstaSenhaForte123!

LOG_LEVEL=info
